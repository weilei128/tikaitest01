<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.datamanagement.mapper.DcMdProjectMapper">

    <resultMap type="com.oo.datamanagement.api.domain.DcMdProject" id="DcMdProjectResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="nameDetail" column="name_detail"/>
        <result property="parentId" column="parent_id"/>
        <result property="type" column="type"/>
        <result property="organizationId" column="organization_id"/>
        <result property="orderNum" column="order_num"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="geomWkt" column="geom_wkt"/>
        <result property="geomType" column="geom_type"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <resultMap type="com.oo.common.core.web.domain.SysMenuWell" id="SysWdpQueryResult2">
        <result property="menuId"     column="id"      />
        <result property="menuName"     column="name"      />
        <result property="parentId"     column="parent_id"      />
        <result property="orderNum"     column="order_num"      />
        <result property="label_datail"     column="name_detail"      />
        <result property="longitude"     column="longitude"      />
        <result property="latitude"     column="latitude"      />
        <result property="create_time"     column="create_time"      />
        <result property="type"     column="type"      />
        <result property="organization_id"     column="organization_id"      />
    </resultMap>

    <sql id="selectDcMdProjectVo">
        select id, name, name_detail, parent_id, `type`, organization_id, order_num, longitude, latitude, geom_wkt, geom_type, create_by, create_time, update_by, update_time, remark from dc_md_project
    </sql>

    <select id="selectDcMdProjectList" parameterType="com.oo.datamanagement.api.domain.DcMdProject" resultMap="DcMdProjectResult">
        <include refid="selectDcMdProjectVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="nameDetail != null  and nameDetail != ''"> and name_detail = #{nameDetail}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="type != null "> and `type` = #{type}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="longitude != null "> and longitude = #{longitude}</if>
            <if test="latitude != null "> and latitude = #{latitude}</if>
            <if test="geomWkt != null  and geomWkt != ''"> and geom_wkt = #{geomWkt}</if>
            <if test="geomType != null "> and geom_type = #{geomType}</if>
        </where>
    </select>

    <select id="selectTreeList"  resultMap="SysWdpQueryResult2">
        select id,name,parent_id,order_num,name_detail,longitude,latitude,create_time,type,organization_id
        from `gjgs-dc`.dc_md_project
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
        </where>
    </select>

