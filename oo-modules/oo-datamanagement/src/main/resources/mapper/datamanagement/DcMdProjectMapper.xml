    <select id="selectScreenTreeList"  resultMap="SysWdpQueryResult2">
        select c.parentid AS parent_id,c.id,c.type, case when c.blockname is null then c.companyname else c.blockname end as name from (
        SELECT
        0 AS `parentid`,
        `company_view`.`companyname` AS `companyname`,
        NULL AS `blockid`,
        NULL AS `blockname`,
        CONCAT(`company_view`.`pid`,'002') AS `id`,
        `company_view`.`type` AS `type`
        FROM
        `gjgs-dc`.`company_view`
        UNION
        SELECT
        CONCAT(`block_view`.`companyid`,'002') AS `parentid`,
        `block_view`.`companyname` AS `companyname`,
        `block_view`.`blockid` AS `blockid`,
        `block_view`.`blockname` AS `blockname`,
        CONCAT(`block_view`.`pid`,'003') AS `id`,
        `block_view`.`type` AS `type`
        FROM
        `gjgs-dc`.`block_view`
        UNION
        SELECT
        CONCAT(`block_wellarea_view`.`companyid`,'002') AS `parentid`,
        `block_wellarea_view`.`companyname` AS `companyname`,
        `block_wellarea_view`.`blockid` AS `blockid`,
        `block_wellarea_view`.`blockname` AS `blockname`,
        CONCAT(`block_wellarea_view`.`pid`,'004') AS `id`,
        `block_wellarea_view`.`type` AS `type`
        FROM
        `gjgs-dc`.`block_wellarea_view`
        ) c
        <where>
             AND c.type != 6
            <if test="beginTime != null">
                AND date_format(prod_date,'%y%m%d') >= date_format(#{beginTime},'%y%m%d')
            </if>
           <if test="endTime != null">
                AND date_format(prod_date,'%y%m%d') &lt;=  date_format(#{endTime},'%y%m%d')
           </if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>

    <select id="selectMaxId" resultType="Long">
		select MAX(id)  from dc_md_project
	</select>
</mapper>
