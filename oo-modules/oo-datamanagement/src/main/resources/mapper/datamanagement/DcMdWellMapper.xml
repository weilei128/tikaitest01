        </where>
    </select>-->
    <select id="selectScreenTreeList"  resultMap="SysWdpQueryResult2">
        select * from (select id, name ,parent_id, null prod_date,type  from `gjgs-dc`.dc_md_organization   union
        select id, wellname as name ,organization_id as parent_id,prod_date,null from `gjgs-dc`.dc_md_well ) wellInfo order by parent_id
        <where>
            <if test="beginTime != null">
                AND date_format(prod_date,'%y%m%d') >= date_format(#{beginTime},'%y%m%d')
            </if>
            <if test="endTime != null">
                AND date_format(prod_date,'%y%m%d') &lt;=  date_format(#{endTime},'%y%m%d')
            </if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>

</mapper>
