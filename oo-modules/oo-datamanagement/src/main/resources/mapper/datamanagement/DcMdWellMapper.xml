    <sql id="selectDcMdWellVo">
        select id, wellname, chinesewellname, organization_id, project_id, ifwork, welltype, wellsubtype, usertxt6, `type`, longitude, latitude, prod_date, order_num, create_by, create_time, update_by, update_time, remark from dc_md_well
    </sql>

    <select id="selectDcMdWellList" parameterType="com.oo.datamanagement.api.domain.DcMdWell" resultMap="DcMdWellResult">
        <include refid="selectDcMdWellVo"/>
        <where>
            <if test="wellname != null  and wellname != ''"> and wellname like concat('%', #{wellname}, '%')</if>
            <if test="chinesewellname != null  and chinesewellname != ''"> and chinesewellname like concat('%', #{chinesewellname}, '%')</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="ifwork != null "> and ifwork = #{ifwork}</if>
            <if test="welltype != null  and welltype != ''"> and welltype = #{welltype}</if>
            <if test="wellsubtype != null  and wellsubtype != ''"> and wellsubtype = #{wellsubtype}</if>
            <if test="usertxt6 != null  and usertxt6 != ''"> and usertxt6 = #{usertxt6}</if>
            <if test="type != null  and type != ''"> and `type` = #{type}</if>
            <if test="longitude != null "> and longitude = #{longitude}</if>
            <if test="latitude != null "> and latitude = #{latitude}</if>
            <if test="prodDate != null "> and prod_date = #{prodDate}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
        </where>
    </select>

    <select id="selectWellType" resultMap="Result">
		select pk_code,name from dc_pk_well_type
	</select>

    <select id="selectPurpose" resultMap="Result">
		select pk_code,name from dc_pk_well_purpose
        <where>
            <if test="type != null "> and type = #{type}</if>
        </where>
	</select>


    <select id="selectCompany" resultMap="SysWdpQueryResult3">
		select companyid as companyId,companyname as companyName  from project_well_view WHERE
        pid = #{projectId} limit 1
    </select>


    <select id="select"  resultMap="DcMdWellResult2">
        select a.id, a.wellname, a.chinesewellname, a.organization_id, a.project_id, a.ifwork, a.welltype, a.wellsubtype, a.usertxt6, a.`type`,
        a.longitude, a.latitude, a.prod_date, a.order_num, a.create_by, a.create_time, a.update_by, a.update_time, a.remark,
        b.projectname as organizationName,
        h.name as projectName,
        c.dict_label as ifworkName,
        d.dict_label as welltypeName,
        e.dict_label as wellsubtypeName,
        f.dict_label as usertxt6Name,
        g.dict_label as typeName,

        a.ifwork as ifworkId,
        a.welltype as welltypeId,
        a.wellsubtype as wellsubtypeId,
        a.usertxt6 as usertxt6Id,
        a.type as typeId,

        b.companyid  as companyId,
        b.companyname as companyName
        from dc_md_well a left join  project_view b on a.organization_id=b.projectId
        left join dc_md_project h on a.project_id=h.id
        left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='if_or_no') c on a.ifwork = c.dict_value
        left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='well_type') d on a.welltype = d.dict_value
        left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='wellsubtype') e on a.wellsubtype = e.dict_value
        left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='usertxt6') f on a.usertxt6 = f.dict_value
        left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='dc_pk_well_type') g on a.type = g.dict_value
        <where>
            1=1
            <if test="wellId != null  and wellId != ''"> and a.id = #{wellId}</if>
            <if test="projectId != null  and projectId != ''"> and a.organization_id = #{projectId} or b.companyId = #{projectId}</if>
            <!-- <if test="type=='2'"> and b.type = #{type}</if>-->
         </where>
    </select>

