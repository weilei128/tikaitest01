        <result property="companyName"     column="companyname"      />
        <result property="blockId"     column="blockid"      />
        <result property="blockName"     column="blockname"      />
        <result property="wellId"     column="wellid"      />
        <result property="wellName"     column="wellname"      />
        <result property="chineseWellName"     column="chinesewellname"      />
        <result property="ifWork"     column="ifwork"      />
        <result property="iffocus"     column="if_focus"      />
        <result property="latitude"     column="block_latitude"      />
        <result property="longitude"     column="block_longitude"      />
