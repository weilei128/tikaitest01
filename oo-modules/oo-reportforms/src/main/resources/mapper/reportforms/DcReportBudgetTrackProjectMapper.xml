<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.reportforms.mapper.DcReportBudgetTrackProjectMapper">
    
    <resultMap type="com.oo.reportforms.domain.DcReportBudgetTrackProject" id="DcReportBudgetTrackProjectResult">
        <result property="trackId" column="track_id"/>
        <result property="name" column="name"/>
        <result property="value" column="value"/>
    </resultMap>

    <sql id="selectDcReportBudgetTrackProjectVo">
        select track_id, name, value from dc_report_budget_track_project
    </sql>

    <select id="selectDcReportBudgetTrackProjectList" parameterType="com.oo.reportforms.domain.DcReportBudgetTrackProject" resultMap="DcReportBudgetTrackProjectResult">
        <include refid="selectDcReportBudgetTrackProjectVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="value != null "> and value = #{value}</if>
        </where>
    </select>
    
</mapper>