    <sql id="selectDcReportRiskCheckNcrVo">
        select id, well_control_inspection, resource_type, facilities, well_id, risk_criticality_ranking, registering_date, nc_description, nc_corrective_action, required_close_time, actrual_close_time, nc_status, reasons_for_open_items, risk_control_measures, plan_close_time, responsible_person, create_by, create_time, update_by, update_time, remark, del_flag, del_user, del_time from dc_report_risk_check_ncr
    </sql>

    <select id="selectList" parameterType="com.oo.reportforms.domain.vo.DcReportRiskCheckNcrVo" resultMap="DcReportRiskCheckNcrVoResult">
        select a.id, a.well_control_inspection, a.resource_type, a.facilities, a.well_id, a.risk_criticality_ranking, a.registering_date,
        a.nc_description, a.nc_corrective_action, a.required_close_time, a.actrual_close_time, a.nc_status, a.reasons_for_open_items,
        a.risk_control_measures, a.plan_close_time, a.responsible_person, a.create_by, a.create_time, a.update_by, a.update_time, a.remark, a.del_flag, a.del_user, a.del_time,
        b.wellname
--         ,c.dict_label as resourceTypeName,
--         d.dict_label as facilitiesName,
--         e.dict_label as riskCriticalityRankingName,
--         f.dict_label as ncStatusName
        from dc_report_risk_check_ncr a
        left join dc_md_well b on a.well_id = b.id
--         left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='resource_type') c on a.resource_type = c.dict_value
--         left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='check_facilities') d on a.facilities = d.dict_value
--         left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='risk_criticality_ranking') e on a.risk_criticality_ranking = e.dict_value
--         left join (select dict_label,dict_value from `gjgs-dc-cloud`.sys_dict_data where dict_type='nc_status') f on a.nc_status = f.dict_value
        <where>
            a.del_flag = '0'
            <if test="wellId != null  and wellId != ''">
                AND b.id = #{wellId}
            </if>
            <if test="beginTime != null">
                AND date_format(a.registering_date,'%y%m%d') >= date_format(#{beginTime},'%y%m%d')
            </if>
            <if test="endTime != null">
                AND date_format(a.registering_date,'%y%m%d') &lt;=  date_format(#{endTime},'%y%m%d')
            </if>
            <if test="ncStatus != null">
                AND a.nc_status = #{ncStatus}
            </if>
        </where>
    </select>

    <select id="getWellName" parameterType="com.oo.system.api.vo.DcMdWellVo" resultMap="DcMdWellVoResult">
        select a.id as organization_id,a.`name`,a.parent_id as organization_parentid,a.order_num,a.type,b.id as project_id,
               b.name as projectname,b.parent_id as project_parentid,c.id as wellid,c.wellname from dc_md_organization a
               left join dc_md_project b on a.id = b.organization_id
               left join dc_md_well c on b.id = c.project_id order by a.order_num ,a.type
    </select>

