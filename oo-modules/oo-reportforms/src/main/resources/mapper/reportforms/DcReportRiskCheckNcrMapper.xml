    <delete id="deleteItemsByIds">
        delete from dc_report_risk_check_ncr where id in
        <foreach item="ids" collection="array" open="(" separator="," close=")">
            #{ids}
        </foreach>
    </delete>

    <select id="getWellId" parameterType="com.oo.system.api.vo.DcMdWellVo" resultMap="ResultWellId">
        select a.id as organization_id,a.`name`,a.parent_id as organization_parentid,a.order_num,a.type,b.id as project_id,
        b.name as projectname,b.parent_id as project_parentid,c.id as wellid,c.wellname from dc_md_organization a
        left join dc_md_project b on a.id = b.organization_id
        left join dc_md_well c on b.id = c.project_id
        where c.wellname = #{wellName}
        order by a.order_num ,a.type
    </select>

