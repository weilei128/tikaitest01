<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.reportforms.mapper.DcReportDrillWellAssesMapper">

    <select id="selectName"  resultType="String">
        select name from dc_md_organization
        <where>
            <if test="id != null  and id != ''"> and id = #{id}</if>
        </where>
    </select>
    <select id="organizationId"  resultType="String">
        select id from dc_md_organization
        <where>
            <if test="name != null  and name != ''"> and name = #{name}</if>
        </where>
    </select>

    <select id="projectName"  resultType="String">
        select name from dc_md_project
        <where>
            <if test="id != null  and id != ''"> and id = #{id}</if>
        </where>
    </select>

    <select id="selectWellName"  resultType="String">
        select wellname from dc_md_well
        <where>
            <if test="id != null  and id != ''"> and id = #{id}</if>
        </where>
    </select>
    <select id="selectWellType"  resultType="String">
        select name from dc_pk_well_type
        <where>
            <if test="id != null  and id != ''"> and pk_code = #{id}</if>
        </where>
    </select>
    <delete id="deleteItemsByIds">
        delete from dc_report_drill_well_asses where id in
        <foreach item="ids" collection="array" open="(" separator="," close=")">
            #{ids}
        </foreach>
    </delete>

    <select id="selectCountryName"  resultType="String">
        select companyname from organization_tb_view
        <where>
            <if test="id != null  and id != ''"> and pid= #{id}</if>
        </where>
    </select>
</mapper>
