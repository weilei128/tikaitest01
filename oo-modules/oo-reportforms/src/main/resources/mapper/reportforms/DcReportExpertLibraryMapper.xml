<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.reportforms.mapper.DcReportExpertLibraryMapper">
    
    <resultMap type="com.oo.reportforms.domain.DcReportExpertLibrary" id="DcReportExpertLibraryResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="unit" column="unit"/>
        <result property="technicalTitle" column="technical_title"/>
        <result property="expertLevel" column="expert_level"/>
        <result property="engineerLevel" column="engineer_level"/>
        <result property="speciality" column="speciality"/>
        <result property="ifRetire" column="if_retire"/>
        <result property="year" column="year"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="delUser" column="del_user"/>
        <result property="delTime" column="del_time"/>
    </resultMap>

    <sql id="selectDcReportExpertLibraryVo">
        select id, name, unit, technical_title, expert_level, engineer_level, speciality, if_retire, year, create_by, create_time, update_by, update_time, remark, del_flag, del_user, del_time from dc_report_expert_library
    </sql>

    <select id="selectDcReportExpertLibraryList" parameterType="com.oo.reportforms.domain.DcReportExpertLibrary" resultMap="DcReportExpertLibraryResult">
        <include refid="selectDcReportExpertLibraryVo"/>
        <where>
            del_flag = '0'
            <if test="unit != null  and unit != ''"> and unit like concat('%', #{unit}, '%')</if>
            <if test="technicalTitle != null  and technicalTitle != ''"> and technical_title like concat('%', #{technicalTitle}, '%')</if>
            <if test="ifRetire != null  and ifRetire != ''"> and if_retire = #{ifRetire}</if>
            <if test="beginTime != null">
                AND date_format(year,'%y')  &gt;= date_format(#{beginTime},'%y')
            </if>
            <if test="endTime != null">
                AND date_format(year,'%y') &lt;=  date_format(#{endTime},'%y')
            </if>
        </where>
    </select>

    <delete id="deleteItemsByIds">
        delete from dc_report_expert_library where id in
        <foreach item="ids" collection="array" open="(" separator="," close=")">
            #{ids}
        </foreach>
    </delete>
</mapper>