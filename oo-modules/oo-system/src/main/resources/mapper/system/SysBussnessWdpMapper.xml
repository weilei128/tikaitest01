<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.system.mapper.SysBussnessWdpMapper">
    
    <resultMap type="com.oo.system.domain.SysBussnessWdp" id="SysBussnessWdpResult">
        <result property="id" column="id"/>
        <result property="bussnessId" column="bussness_id"/>
        <result property="wdpId" column="wdp_id"/>
    </resultMap>

    <sql id="selectSysBussnessWdpVo">
        select id, bussness_id, wdp_id from sys_bussness_wdp
    </sql>

    <select id="selectSysBussnessWdpList" parameterType="SysBussnessWdp" resultMap="SysBussnessWdpResult">
        <include refid="selectSysBussnessWdpVo"/>
        <where>  
            <if test="bussnessId != null "> and bussness_id = #{bussnessId}</if>
            <if test="wdpId != null "> and wdp_id = #{wdpId}</if>
        </where>
    </select>

