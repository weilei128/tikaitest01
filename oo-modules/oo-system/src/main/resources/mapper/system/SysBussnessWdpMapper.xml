    <insert id="insertSysBussnessWdp">
        insert into sys_bussness_wdp(id, wdp_id,bussness_id) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.id},#{item.wdpId},#{item.bussnessId})
        </foreach>
    </insert>

    <delete id="deleteSysBussnessWdpById" parameterType="Long">
        delete from sys_bussness_wdp where wdp_id = #{wdpId}
