<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oo.system.mapper.SysDocMenuBusinessMapper">

    <resultMap type="com.oo.system.api.domain.SysDocMenuBusiness" id="SysDocMenuBusinessResult">
        <result property="id" column="id"/>
        <result property="businessName" column="business_name"/>
        <result property="parentId" column="parent_id"/>
        <result property="orderNum" column="order_num"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="isCheck" column="is_check"/>
    </resultMap>

    <sql id="selectSysDocMenuBusinessVo">
        select id, business_name, parent_id, order_num, create_by, create_time, update_by, update_time, remark, is_check  from sys_doc_menu_business
    </sql>

    <select id="selectDocMenuBusinessList" parameterType="SysDocMenuBusiness" resultMap="SysDocMenuBusinessResult">
        <include refid="selectSysDocMenuBusinessVo"/>
       <!-- <where>
            <if test="business_name != null  and business_name != ''"> and business_name like concat('%', #{business_name}, '%')</if>
            <if test="parent_id != null  and parent_id != ''"> and parent_id = #{parent_id}</if>
            <if test="order_num != null "> and order_num = #{order_num}</if>
        </where>-->
    </select>

    <select id="selectDocMenuBusinessNameList" parameterType="SysDocMenuBusiness" resultMap="SysDocMenuBusinessResult">
        <include refid="selectSysDocMenuBusinessVo"/>
        <where>
            <if test="business_name != null  and business_name != ''"> and business_name like concat('%', #{business_name}, '%')</if>
        </where>
    </select>

    <insert id="insertDocMenuBusiness" parameterType="SysDocMenuBusiness" useGeneratedKeys="true" keyProperty="id">
        insert into sys_doc_menu_business(
        <trim suffixOverrides=",">
            <if test="id != null and id != 0">id,</if>
            <if test="businessName != null and businessName != ''">business_name,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="orderNum != null and orderNum != ''">order_num,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="isCheck != null">is_check,</if>
            create_time
        </trim>
        )values(
        <trim suffixOverrides=",">
            <if test="id != null and id != ''">#{id},</if>
            <if test="businessName != null and businessName != ''">#{businessName},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="orderNum != null and orderNum != ''">#{orderNum},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="isCheck != null">#{isCheck},</if>
            sysdate()
        </trim>
        )
    </insert>

    <update id="updateDocMenuBusiness" parameterType="SysDocMenuBusiness">
        update sys_doc_menu_business
        <trim prefix="set" suffixOverrides="," suffix="where id = #{id}">
            <if test="businessName != null and businessName != ''">business_name = #{businessName},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="orderNum != null ">order_num = #{orderNum},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="isCheck != null">is_check = #{isCheck},</if>
            update_time = sysdate()
        </trim>
    </update>

    <delete id="deleteDocMenuBusinessById" parameterType="Long">
        delete from sys_doc_menu_business where id = #{id}
    </delete>

    <delete id="deleteDocMenuBusinessByIds" parameterType="Long">
        delete from sys_doc_menu_business where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="selectChildIds" parameterType="Long" resultType="Long">
        select id
        from sys_doc_menu_business
        <where>
            <if test="businessId != null">
                and id = #{businessId} or parent_id = #{businessId}
            </if>
        </where>
    </select>
</mapper>